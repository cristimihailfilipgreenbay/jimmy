# Copy to .env and adjust. Never commit .env.
# The API keys (OPENROUTER_API_KEY, TAVILY_API_KEY, LANGSMITH_API_KEY) are not set
# here: export them in your shell, and Compose passes them to the backend.

# Chat and embeddings (https://openrouter.ai)
TUTOR_MODEL=openai/gpt-6-luna
BACKGROUND_MODEL=openai/gpt-6-luna
# The classifier behind the input guard and injection scan. Empty uses BACKGROUND_MODEL.
GUARD_MODEL=
# Locked once chunks exist.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Database. The defaults work as they are.
# Changing the user, password or database name only applies to a NEW database
# volume. To change them on an existing one, reset it (this deletes its data):
#   docker compose down -v
POSTGRES_USER=jimmy
POSTGRES_PASSWORD=jimmy
POSTGRES_DB=jimmy
# Port published on your machine (127.0.0.1 only) for database tools. Inside
# Docker the backend always reaches the database at db:5432.
POSTGRES_PORT=5432
# Only for running the backend outside Docker. Overrides POSTGRES_* when set.
# DATABASE_URL=postgresql+psycopg://jimmy:jimmy@localhost:5432/jimmy

# Ports published on your machine.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Signs the session cookie. Generate one with: openssl rand -hex 32
# Left empty, a random one is used and everyone is signed out on each restart.
JWT_SECRET=
# Hours a sign-in lasts, and the shorter one when "keep me signed in" is off.
SESSION_HOURS=168
SHORT_SESSION_HOURS=12
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# Tracing (https://smith.langchain.com). EU endpoint.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=jimmy
